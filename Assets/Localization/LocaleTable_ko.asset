  m_Name: LocaleTable_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: d1242a3087995484e9e4060056bbe48b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16942796800
    m_Localized: "\uC190\uC804\uB4F1"
    m_Metadata:
      m_Items: []
  - m_Id: 17077014528
    m_Localized: "\uC190\uC804\uB4F1\uC774\uB2E4. \uC774\uAC83\uC774 \uC5C6\uC73C\uBA74
      \uC544\uBB34\uAC83\uB3C4 \uBCFC \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17077014529
    m_Localized: "\uBCFC\uD2B8 \uCEE4\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 17077014530
    m_Localized: "\uC0AC\uC2AC\uC744 \uB04A\uC744 \uC218 \uC788\uB294 \uBCFC\uD2B8
      \uCEE4\uD130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208832
    m_Localized: "\uC2A4\uC704\uCE58\uBCF4\uB4DC \uBE44\uBC00\uBC88\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208833
    m_Localized: "\uBE44\uBC00\uBC88\uD638\uAC00 \uC801\uD600\uC788\uB2E4. 1318"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208834
    m_Localized: "\uB3C4\uC5B4 \uC624\uD504\uB108"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208835
    m_Localized: "\uBB38\uC744 \uAC1C\uBC29\uD560 \uC218 \uC788\uB294 \uB3C4\uAD6C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208836
    m_Localized: USB
    m_Metadata:
      m_Items: []
  - m_Id: 17081208837
    m_Localized: "\uC2E4\uD5D8\uB0B4\uC6A9\uC774 \uB2F4\uACA8\uC788\uB2E4\uB294 USB\uB2E4.
      \uC804\uB825\uC774 \uBCF5\uAD6C\uB418\uBA74 \uCEF4\uD4E8\uD130\uC5D0 \uC5F0\uACB0\uD574\uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208838
    m_Localized: 6
    m_Metadata:
      m_Items: []
  - m_Id: 17081208839
    m_Localized: "\uC804\uB825 \uAD00\uB9AC\uC2E4\uC5D0\uC11C \uBCF8 \uC22B\uC790
      6\uC774\uB2E4. \uC5B4\uB5A4 \uC758\uBBF8\uC77C\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208840
    m_Localized: 1
    m_Metadata:
      m_Items: []
  - m_Id: 17081208841
    m_Localized: "\uB09C\uBC29 \uAD00\uB9AC\uC2E4\uC5D0\uC11C \uBCF8 \uC22B\uC790
      1\uC774\uB2E4. \uB354 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208842
    m_Localized: 3
    m_Metadata:
      m_Items: []
  - m_Id: 17081208843
    m_Localized: "\uAE30\uC219\uC0AC \uBB38 \uB108\uBA38\uB85C \uBCF8 \uC22B\uC790
      3\uC774\uB2E4. \uBB34\uC2A8 \uB73B\uC77C\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208844
    m_Localized: "\uC0AC\uB2E4\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208845
    m_Localized: "\uC774\uAC83\uC774\uB77C\uBA74 \uD658\uD48D\uAD6C\uC5D0 \uC62C\uB77C\uAC08
      \uC218 \uC788\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208846
    m_Localized: "\uCE74\uB4DC\uD0A4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208847
    m_Localized: "\uCE74\uB4DC\uD0A4\uB85C \uC5F4 \uC218 \uC788\uB294 \uBB38\uB4E4\uC774
      \uC788\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208848
    m_Localized: "\uC2E4\uD5D8\uC2E4 \uBE44\uBC00\uBC88\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208849
    m_Localized: "\uB204\uAD70\uAC00 \uB0A8\uACA8\uB454 \uCABD\uC9C0\uB2E4. \uD0D0\uC0C9
      \uC21C\uC11C\uB97C \uC798 \uC0DD\uAC01\uD574\uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208850
    m_Localized: "\uC2E4\uD5D8 \uC77C\uC9C0\n\uC2E4\uD5D8\uCCB4: DE5i1\nX-ray, CT,
      MRI, \uCE74\uBA54\uB77C \uB4F1 \uBAA8\uB4E0 \uC601\uC0C1 \uC7A5\uBE44\uB97C
      \uC0AC\uC6A9\uD558\uC5EC \uAD00\uCC30\uC744 \uC2DC\uB3C4\uD588\uC73C\uB098,
      \uD655\uC778 \uAC00\uB2A5\uD55C \uB0B4\uBD80 \uAD6C\uC870\uB294 \uC874\uC7AC\uD558\uC9C0
      \uC54A\uC558\uB2E4.\n\uADF8\uB7EC\uB098 \uC678\uBD80 \uC790\uADF9\uC5D0 \uBC18\uC751\uD558\uB294
      \uB4F1 \uC0DD\uBB3C\uACFC \uC720\uC0AC\uD55C \uBC18\uC751\uC744 \uBCF4\uC774\uB294
      \uAC83\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\n\uD2B9\uD788 \uBE5B\uACFC \uC18C\uB9AC\uC5D0
      \uBBFC\uAC10\uD558\uAC8C \uBC18\uC751\uD558\uB294 \uD2B9\uC131\uC774 \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\n\uC2E4\uD5D8
      \uC77C\uC9C0\n\uC2E4\uD5D8\uCCB4: DE5i1\n\uC950, \uD1A0\uB07C, \uACF0\uC744
      \uC21C\uCC28\uC801\uC73C\uB85C \uC2E4\uD5D8\uC2E4\uC5D0 \uD22C\uC785\uD558\uC600\uB2E4.\n\uD22C\uC785\uC77C\uC740
      6\uC6D4 X\uC77C, 7\uC6D4 X\uC77C, 8\uC6D4 X\uC77C\uC774\uB2E4.\n\uBAA8\uB4E0
      \uD53C\uD5D8 \uB3D9\uBB3C\uC5D0\uAC8C\uC11C \uC2E4\uD5D8\uCCB4\uB97C \uBC1C\uACAC\uD55C
      \uC9C1\uD6C4 \uADF9\uB3C4\uC758 \uACF5\uD3EC \uBC18\uC751\uC774 \uAD00\uCC30\uB418\uC5C8\uB2E4.\nDE5i1\uC740
      \uD53C\uD5D8 \uB3D9\uBB3C\uB4E4\uC744 \uC77C\uC815 \uC2DC\uAC04 \uAD00\uCC30\uD55C
      \uD6C4 \uACF5\uACA9 \uD589\uB3D9\uC744 \uBCF4\uC600\uB2E4.\n\uACF5\uACA9 \uC774\uD6C4
      \uB3D9\uBB3C\uC758 \uC2E0\uCCB4\uB294 \uD615\uCCB4\uB97C \uC2DD\uBCC4\uD560
      \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uC2EC\uD558\uAC8C \uD6FC\uC190\uB418\uC5C8\uC73C\uBA70,
      \uC5BC\uB9C8 \uC9C0\uB098\uC9C0 \uC54A\uC544 \uAC80\uC740\uC0C9 \uB369\uC5B4\uB9AC
      \uD615\uD0DC\uB85C \uBCC0\uC774\uD558\uC600\uB2E4.\n\uD574\uB2F9 \uAC80\uC740\uC0C9
      \uBB3C\uC9C8\uC740 Fomes\uB85C \uBA85\uBA85\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208851
    m_Localized: "\uC2E4\uD5D8 \uC77C\uC9C0\n\uC2E4\uD5D8\uCCB4: DE5i1\n\uC5F0\uAD6C\uC6D0
      A\uAC00 \uC2E4\uD5D8\uCCB4 DE5i1\uC774 \uBD84\uC5F4\uD55C \uD6C4 \uB2E4\uC2DC
      \uD558\uB098\uC758 \uAC1C\uCCB4\uB85C \uD569\uCCD0\uC9C0\uB294 \uBAA8\uC2B5\uC744
      \uBAA9\uACA9\uD558\uACE0 \uBCF4\uACE0\uD558\uC600\uB2E4.\nDE5i1\uC740 CCTV\uC5D0
      \uC601\uC0C1\uC774 \uAE30\uB85D\uB418\uC9C0 \uC54A\uB294 \uD2B9\uC131\uC774
      \uC788\uC5B4 \uB2F9\uC2DC \uC0C1\uD669\uC5D0 \uB300\uD55C \uC99D\uAC70\uB294
      \uD655\uBCF4\uD558\uC9C0 \uBABB\uD588\uB2E4. \uC774\uC5D0 \uC774\uD6C4 \uC5F0\uAD6C\uC6D0\uB4E4\uC774
      \uAD50\uB300\uB85C \uC2E4\uD5D8\uCCB4\uB97C \uAC10\uC2DC\uD558\uC600\uB2E4.\n\uC774\uD6C4
      \uC5F0\uAD6C\uC6D0 B \uC5ED\uC2DC DE5i1\uC774 \uBD84\uC5F4\uD558\uB294 \uBAA8\uC2B5\uC744
      \uD655\uC778\uD558\uC600\uB2E4.\n\uB3D9\uC77C\uD55C \uD604\uC0C1\uC774 \uBC18\uBCF5\uC801\uC73C\uB85C
      \uAD00\uCC30\uB428\uC5D0 \uB530\uB77C DE5i1\uC758 \uBD84\uC5F4 \uD604\uC0C1\uC744
      \uC0AC\uC2E4\uB85C \uAC04\uC8FC\uD558\uACE0 \uD6C4\uC18D \uC2E4\uD5D8\uC744
      \uC9C4\uD589\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208852
    m_Localized: "\uBCF4\uACE0\uC11C\n\uAE30\uC874 \uC2E4\uD5D8 \uAE30\uB85D\uC744
      \uC885\uD569\uD558\uC5EC \uBD84\uC11D\uD55C \uACB0\uACFC, \uB3D9\uBB3C \uD22C\uC785
      \uC774\uD6C4 DE5i1\uC758 \uBD84\uC5F4 \uD604\uC0C1\uC774 \uBC1C\uC0DD\uD558\uB294
      \uAC83\uC73C\uB85C \uCD94\uC815\uB41C\uB2E4.\n\uD574\uB2F9 \uAC00\uC124\uC744
      \uAC80\uC99D\uD558\uAE30 \uC704\uD574 \uB3D9\uBB3C \uD22C\uC785 \uC2E4\uD5D8\uC744
      \uCD94\uAC00\uB85C \uC9C4\uD589\uD560 \uAC83\uC744 \uC81C\uC548\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208853
    m_Localized: "15\uBC88\uC9F8 \uC2E4\uD5D8 \uBCF4\uACE0\uC11C\n\uC2E4\uD5D8\uCCB4:
      Fomes\n15\uBC88\uC9F8 \uC2E4\uD5D8 - \uC5F0\uC18C \uBC18\uC751 \uC2E4\uD5D8\nFomes\uC5D0
      \uC810\uD654\uD558\uC5EC \uC5F0\uC18C \uBC18\uC751\uC744 \uAD00\uCC30\uD558\uC600\uB2E4.\n\uB3D9\uC77C
      \uBD80\uD53C\uC758 \uC11D\uD0C4\uACFC \uBE44\uAD50\uD55C \uACB0\uACFC, \uC57D
      80~100\uBC30 \uC774\uC0C1 \uC7A5\uC2DC\uAC04 \uC5F0\uC18C\uAC00 \uC9C0\uC18D\uB418\uB294
      \uAC83\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\n\n\uAC10\uB3C5\uAD00 \uC758\uACAC:
      \uC720\uC758\uBBF8\uD55C \uC2E4\uD5D8 \uACB0\uACFC\uAC00 \uD655\uC778\uB418\uC5C8\uB2E4.
      \uB300\uCCB4 \uC5F0\uB8CC\uB85C\uC11C\uC758 \uD65C\uC6A9 \uAC00\uB2A5\uC131\uC774
      \uC788\uB294 \uAC83\uC73C\uB85C \uD310\uB2E8\uB418\uBA70, \uCD94\uAC00 \uC2E4\uD5D8\uC744
      \uC9C4\uD589\uD560 \uAC83\uC744 \uC694\uCCAD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208854
    m_Localized: "13\uBC88\uC9F8 \uC2E4\uD5D8 \uBCF4\uACE0\uC11C\n\uC2E4\uD5D8\uCCB4:
      DE5i1\n13\uBC88\uC9F8 \uC2E4\uD5D8 -  XX \uBC18\uC751 \uC2E4\uD5D8\nDE5i1\uC5D0
      XX \uC790\uADF9\uC744 \uAC00\uD55C \uACB0\uACFC, \uAE38\uAC8C \uBED7\uC740
      \uBD89\uC740 \uC2E4 \uD615\uD0DC\uC758 \uBB3C\uC9C8\uC774 \uB098\uD0C0\uB0AC\uB2E4.\n\uC678\uD615\uC740
      \uD3C9\uC18C\uC5D0\uB3C4 \uAD00\uCC30\uB418\uB294 \uBD89\uC740 \uC2E4\uACFC
      \uB3D9\uC77C\uD558\uB098, \uAE38\uC774\uB294 \uAE30\uC874\uBCF4\uB2E4 \uC57D
      4~6\uBC30 \uAE34 \uAC83\uC73C\uB85C \uD655\uC778\uB418\uC5C8\uB2E4.\n\n\uAC10\uB3C5\uAD00
      \uC758\uACAC: \uC0C8\uB85C\uC6B4 \uD615\uD0DC\uC758 \uBD89\uC740 \uC2E4\uC774
      \uD655\uC778\uB418\uC5C8\uB2E4. \uD574\uB2F9 \uBD89\uC740 \uC2E4\uC5D0 \uB300\uD55C
      \uCD94\uAC00\uC801\uC778 \uAD00\uCC30 \uBC0F \uC2E4\uD5D8\uC744 \uC9C4\uD589\uD560
      \uAC83\uC744 \uC694\uCCAD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208855
    m_Localized: "\uADF9\uBE44 \uC2E4\uD5D8 \uBCF4\uACE0\uC11C\n\uC2E4\uD5D8\uCCB4:
      DE5i1\n\uBA58\uD15C \uB808\uAC8C\uB808 \uC2E4\uD5D8 - 13\uBC88\uC9F8 XX \uC790\uADF9
      \uBC18\uC751 \uC2E4\uD5D8 \uC774\uD6C4 \uCD94\uAC00 \uC2E4\uD5D8\n\nXX \uC790\uADF9\uC744
      \uAC00\uD55C \uD6C4 \uD1A0\uB07C\uB97C \uD22C\uC785\uD558\uC600\uB2E4. \uBD89\uC740
      \uC2E4\uC5D0 \uC811\uCD09\uD55C \uD1A0\uB07C\uC5D0\uAC8C\uC11C \uC774\uC0C1
      \uBC18\uC751\uC774 \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\uC774\uD6C4 \uD574\uB2F9
      \uC790\uADF9\uC744 \uAC00\uD55C \uC5F0\uAD6C\uC6D0\uC774 \uBA85\uB839\uC744
      \uB0B4\uB9AC\uC790 \uD1A0\uB07C\uAC00 \uC774\uC5D0 \uB530\uB974\uB294 \uBAA8\uC2B5\uC774
      \uD655\uC778\uB418\uC5C8\uB2E4. \uB2E4\uB978 \uC5F0\uAD6C\uC6D0\uB4E4\uC758
      \uBA85\uB839\uC5D0\uB294 \uBC18\uC751\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\n\uB450
      \uBC88\uC9F8 \uC2E4\uD5D8\uC5D0\uC11C\uB294 \uC0AC\uD615\uC218\uB97C \uD22C\uC785\uD55C
      \uD6C4 XX \uC790\uADF9\uC744 \uAC00\uD558\uC600\uB2E4. \uB3D9\uC77C\uD558\uAC8C
      \uC790\uADF9\uC744 \uAC00\uD55C \uC5F0\uAD6C\uC6D0\uC758 \uBA85\uB839\uC5D0\uB9CC
      \uBC18\uC751\uD558\uB294 \uD604\uC0C1\uC774 \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\uC774\uC0C1\uC758
      \uACB0\uACFC\uB97C \uD1B5\uD574 XX \uC790\uADF9\uC5D0 \uC758\uD574 \uD53C\uD5D8\uCCB4\uC758
      \uD589\uB3D9\uC744 \uC9C1\uC811\uC801\uC73C\uB85C \uD1B5\uC81C\uD560 \uC218
      \uC788\uB294 \uAC83\uC73C\uB85C \uD310\uB2E8\uB41C\uB2E4.\n\nXX \uC790\uADF9\uC744
      \uD1B5\uD574 \uD53C\uD5D8\uCCB4\uC758 \uC815\uC2E0 \uBC0F \uD589\uB3D9\uC744
      \uD1B5\uC81C\uD558\uB294 \uACFC\uC815\uC744 Mentem Regere, \uC57D\uCE59 Mentem\uC73C\uB85C
      \uBA85\uBA85\uD55C\uB2E4.\nMentem\uC5D0 \uC758\uD574 \uD1B5\uC81C\uB418\uB294
      \uD53C\uD5D8\uCCB4\uB294 Servus\uB85C \uBA85\uBA85\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208856
    m_Localized: "\uADF9\uBE44 \uC2E4\uD5D8 \uBCF4\uACE0\uC11C\n\uC2E4\uD5D8\uCCB4:
      Servus\nServus\uB294 \uBA58\uD15C\uC744 \uAC00\uD55C \uC5F0\uAD6C\uC6D0\uC758
      \uBA85\uB839\uC5D0\uB9CC \uBC18\uC751\uD558\uB294 \uD2B9\uC131\uC744 \uBCF4\uC774\uACE0
      \uC788\uB2E4.\nServus\uC5D0\uAC8C '\uB0A0\uC544' \uB77C\uB294 \uBA85\uB839\uC744
      \uB0B4\uB838\uB2E4. Servus\uB294 \uB192\uC740 \uACF3\uC73C\uB85C \uC774\uB3D9\uD55C
      \uD6C4 \uB6F0\uC5B4\uB0B4\uB838\uB2E4.\n\uC2E4\uD589\uC774 \uBD88\uAC00\uB2A5\uD55C
      \uBA85\uB839\uC5D0\uB3C4 \uC774\uD589\uD558\uB824\uB294 \uBAA8\uC2B5\uC744
      \uBCF4\uC778\uB2E4.\n\uC774\uD6C4 Servus\uC5D0\uAC8C XX\uC774\uB780 \uBA85\uB839\uC744
      \uB0B4\uB838\uB2E4.\n\uBA85\uB839 \uC9C1\uD6C4 Servus\uB97C \uC911\uC2EC\uC73C\uB85C
      \uBC18\uACBD \uC57D 20m \uBC94\uC704\uC5D0\uC11C \uACF5\uAC04\uC774 \uC77C\uADF8\uB7EC\uC9C0\uB294
      \uD604\uC0C1\uC774 \uBC1C\uC0DD\uD558\uC600\uB2E4. \uC7A0\uC2DC \uD6C4 \uD574\uB2F9
      \uBC94\uC704 \uB0B4\uC758 \uD658\uACBD\uC774 \uD30C\uAD34\uB41C \uAC83\uC73C\uB85C
      \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\uC678\uD615\uC0C1 \uD3ED\uBC1C\uC5D0 \uC758\uD55C
      \uD30C\uAD34\uC640 \uC720\uC0AC\uD558\uB098, \uC815\uD655\uD55C \uBC1C\uC0DD
      \uACFC\uC815\uC740 \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uB2E4. \uD574\uB2F9
      \uD604\uC0C1\uC740 \uCE74\uBA54\uB77C\uC5D0\uB3C4 \uC815\uC0C1\uC801\uC73C\uB85C
      \uAE30\uB85D\uB418\uC9C0 \uC54A\uC558\uB2E4.\n\nMentem \uBC0F Servus\uC640
      \uAD00\uB828\uB41C \uC2E4\uD5D8\uC740 \uADF9\uBE44 \uC0AC\uD56D\uC73C\uB85C
      \uBD84\uB958\uD55C\uB2E4. \uC77C\uBD80 \uC6A9\uC5B4 \uBC0F \uBA85\uB839\uC740
      1\uAE09 \uAE30\uBC00\uB85C \uC9C0\uC815\uD558\uC5EC \uC5F4\uB78C\uC744 \uC81C\uD55C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208857
    m_Localized: "\uC5F0\uAD6C\uC18C\uC7A5 \uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208858
    m_Localized: "\uC2E4\uD5D8\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208859
    m_Localized: "\uD734\uAC8C\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208860
    m_Localized: "\uBCF4\uC548 \uAD00\uC81C\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208861
    m_Localized: "\uC7A5\uBE44\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208862
    m_Localized: "\uC11C\uBC84\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208863
    m_Localized: "\uD604\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208864
    m_Localized: "\uC2E4\uD5D8\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208865
    m_Localized: "\uC0DD\uD65C\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208866
    m_Localized: "\uC911\uC559 \uD1B5\uC81C\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208867
    m_Localized: "\uC5F0\uAD6C \uC791\uC5C5\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208868
    m_Localized: "\uCC3D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208869
    m_Localized: "\uAE30\uC219\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208870
    m_Localized: "...\uC5EC\uAE34 \uC5B4\uB514\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208871
    m_Localized: "\uB0B4\uAC00 \uC65C \uC5EC\uAE30 \uC788\uB294 \uAC70\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208872
    m_Localized: "\uC6B0\uC120... \uC8FC\uBCC0\uC744 \uB458\uB7EC\uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208873
    m_Localized: "\uADF8\uAC74 \uB3C4\uB300\uCCB4 \uBB50\uC600\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208874
    m_Localized: "\uC800\uACF3\uC740 \uBB58 \uD558\uB294 \uACF3\uC774\uC5C8\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208875
    m_Localized: "\uB098\uB294 \uC65C \uC800\uAE30 \uC788\uC5C8\uB358 \uAC70\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208876
    m_Localized: "\uD55C \uAC00\uC9C0 \uCC1D\uCC1D\uD55C \uAC83\uC774 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208877
    m_Localized: "\uADF8 \uAD34\uBB3C\uC740 \uD615\uCCB4\uB97C \uC54C\uC544\uBCFC
      \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uC9D3\uC774\uAE34\uB2E4\uB294\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208878
    m_Localized: "\uADF8\uB807\uB2E4\uBA74 \uADF8 \uB9CE\uC740 \uC2DC\uCCB4\uB294
      \uBB50\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208879
    m_Localized: "\uD55C \uAC00\uC9C0\uB294 \uC54C \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208880
    m_Localized: "\uC800 \uC0AC\uB78C\uB4E4\uC740 \uADF8 \uAD34\uBB3C\uC744 \uC774\uC6A9\uD558\uB824
      \uD588\uACE0 \uACB0\uAD6D \uC2E4\uD328\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208881
    m_Localized: "\uADF8 \uC2E4\uD328\uAC00 \uC800 \uCC38\uC0C1\uC744 \uB9CC\uB4E4\uC5B4\uB0B8
      \uAC78\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208882
    m_Localized: "\uBCFC\uD2B8 \uCEE4\uD130\uB97C \uC8FC\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208883
    m_Localized: "\uCE74\uB4DC\uD0A4\uB97C \uC8FC\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208884
    m_Localized: "\uC774\uAC70\uB77C\uBA74 \uC815\uBB38\uC744 \uD574\uCCB4\uD560
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208885
    m_Localized: "\uC0AC\uB2E4\uB9AC\uB97C \uC5BB\uC5C8\uB2E4. \uD658\uD48D\uAD6C\uC5D0
      \uC62C\uB77C\uAC08 \uC218 \uC788\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 17081208886
    m_Localized: "\uBB38\uC744 \uC5F4\uC218\uAC00 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17081208887
    m_Localized: "\uCE74\uB4DC\uD0A4\uAC00 \uD544\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403136
    m_Localized: "\uC804\uB825\uC744 \uACF5\uAE09\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403137
    m_Localized: "\uC815\uC2E0\uC774 \uB4E0\uB2E4. \uBD88\uC744 \uCF1C\uBCF4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 17085403138
    m_Localized: "\uC0AC\uC2AC\uC774 \uAC78\uB824\uC788\uB2E4.\n\uBCFC\uD2B8 \uCEE4\uD130\uB97C
      \uCC3E\uC544\uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403139
    m_Localized: "\uC0AC\uB2E4\uB9AC\uAC00 \uC788\uC73C\uBA74 \uC62C\uB77C\uAC08
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403140
    m_Localized: "\uCC45\uAF42\uC774\uAC00 \uC788\uB2E4.\nSF \uC18C\uC124\uCC45,
      \uC7A1\uC9C0, \uC131\uACBD\uCC45\uC774 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403141
    m_Localized: "\uC778\uAC04\uC758 \uC695\uC2EC\uC740 \uB05D\uC774 \uC5C6\uC5B4,\n\uC2E0\uC758
      \uC601\uC5ED\uAE4C\uC9C0 \uB118\uBCF4\uACE0 \uC788\uB2E4.\n\n\uD558\uC9C0\uB9CC...\n\n\uACF5\uC775\uC744
      \uC704\uD574\uC11C... \uADF8\uB798, \uB300\uC758\uB97C \uC704\uD574\uC11C\uB77C\uBA74\n\uC591\uC2EC\uC744
      \uBC84\uB824\uC57C\uD560 \uB54C\uB3C4 \uC788\uB294 \uAC70\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403142
    m_Localized: "\uBE5B\uC744 \uCAD3\uC544\uC624\uACE0 \uC788"
    m_Metadata:
      m_Items: []
  - m_Id: 17085403143
    m_Localized: "\uC0C1\uD638\uC791\uC6A9 \uD0A4\uB97C \uC5F0\uD0C0\uD574 \uC720\uB9AC\uB97C
      \uAE68\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403144
    m_Localized: "\uC0C1\uD638\uC791\uC6A9 \uD0A4\uB97C \uC5F0\uD0C0\uD574 \uBB38\uC744
      \uD574\uCCB4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403145
    m_Localized: "\uC5F0\uAD6C\uC6D01: \uBB38\uC744 \uC218\uB3D9\uC73C\uB85C \uD574\uCCB4\uD558\uB294
      \uBC29\uBC95 \uC54C\uC544?\n\n\uC5F0\uAD6C\uC6D02: \uBB38\uC744 \uC65C \uC218\uB3D9\uC73C\uB85C
      \uC5F4\uC5B4?\n\n\uC5F0\uAD6C\uC6D01: \uB0B4\uAC00 \uC601\uD654\uC5D0\uC11C
      \uBD24\uB294\uB370 \uC720\uC555 \uC624\uD504\uB108\uB97C \uC0AC\uC6A9\uD574\uC11C
      \uACE0\uC7A5\uB09C \uCCA0\uBB38\uC744 \uC5F4\uB354\uB77C\uACE0. \uADF8\uB7F0\uB370
      \uCC3D\uACE0\uC5D0 \uB611\uAC19\uC740 \uC624\uD504\uB108\uAC00 \uC788\uB354\uB77C.\n\n\uC5F0\uAD6C\uC6D02:
      \uBB34\uC2A8 \uBBF8\uC158\uC784\uD30C\uC11C\uBE14 \uCC0D\uB0D0?\n\n\uC5F0\uAD6C\uC6D01:
      \uC65C, \uADF8 \uAC8C\uC2DC\uD310\uB4E4\uC5D0 \uC804\uAE30\uAC00 \uB04A\uAE30\uBA74
      \uC5B4\uB5BB\uAC8C \uB300\uCC98\uD558\uB77C\uACE0 \uBA54\uB274\uC5BC\uC774
      \uB098\uC640 \uC788\uC796\uC544. \uC790\uAC00\uBC1C\uC804\uB3C4 \uB418\uB294
      \uACF3\uC778\uB370 \uADF8\uB7F0 \uBA54\uB274\uC5BC\uC774 \uBC18\uBCF5\uC801\uC73C\uB85C
      \uC368\uC788\uC73C\uB2C8 \uD639\uC2DC\uB098 \uD558\uB294 \uAC70\uC9C0.\n\n\uC5F0\uAD6C\uC6D02:
      \uC4F8\uB370\uC5C6\uB294 \uC18C\uB9AC \uB9D0\uACE0 \uBCF4\uACE0\uC11C\uB098
      \uC791\uC131\uD574\uB77C. \uB0B4\uC77C\uB3C4 \uC2E4\uD5D8 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403146
    m_Localized: "\uC774 \uAE00\uC744 \uBCFC \uB204\uAD70\uAC00\uC5D0\uAC8C \n\uBBF8\uC548\uD558\uB2E4.
      \uC6B0\uB9AC\uB294 \uC2E4\uD328\uD588\uB2E4.\n\uC544\uB2C8, \uC5B4\uCA4C\uBA74
      \uCC98\uC74C\uBD80\uD130 \uC624\uB9CC\uD588\uB2E4.\n\uC6B0\uB9AC\uB294 \uC800
      \uAD34\uBB3C\uC744 \uC774\uC6A9\uD560 \uC218 \uC788\uC744 \uAC83\uC774\uB77C
      \uD310\uB2E8\uD588\uB2E4.\n\uD558\uC9C0\uB9CC \uBC18\uB300\uC600\uB2E4.\n\uBBF8\uC548\uD558\uB2E4.
      \uBBF8\uC548\uD558\uB2E4. \uBBF8\uC548\uD558"
    m_Metadata:
      m_Items: []
  - m_Id: 17085403147
    m_Localized: "[\uC804\uB825 \uC774\uC0C1 \uBC1C\uC0DD \uC2DC]\n\uC804\uB825\uC774
      \uBD88\uC548\uC815\uD560 \uACBD\uC6B0 \uC9C0\uD558 \uC804\uB825 \n\uAD00\uB9AC\uC2E4\uC758
      \uBC30\uC804\uBC18\uC744 \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403148
    m_Localized: "[\uC815\uC804 \uBC1C\uC0DD \uC2DC]\n\uC815\uC804 \uBC1C\uC0DD \uC2DC
      \uBE44\uC0C1 \uBC1C\uC804\uAE30\uAC00 \uAC00\uB3D9\uB429\uB2C8\uB2E4.\n\uCE68\uCC29\uD558\uAC8C
      \uC804\uB825 \uAD00\uB9AC\uC2E4\uC744 \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403149
    m_Localized: "\uC22B\uC790 3\uC774 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403150
    m_Localized: "[\uC5F0\uAD6C \uC791\uC5C5\uC2E4 \uC774\uC6A9 \uC548\uB0B4]\n\uBCF8
      \uC791\uC5C5\uC2E4\uC740 \uBCF4\uACE0\uC11C \uC791\uC131 \uBC0F \uD589\uC815
      \uC5C5\uBB34\uB97C \uC704\uD55C \uACF5\uAC04\uC785\uB2C8\uB2E4.\nPC\uB294 \uC5C5\uBB34
      \uBAA9\uC801\uC73C\uB85C\uB9CC \uC0AC\uC6A9\uD558\uC2ED\uC2DC\uC624.\n\n*\uCEF4\uD4E8\uD130\uB85C
      \uAC8C\uC784\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403151
    m_Localized: "\uC5F0\uAD6C\uC6D01: \uADF8 \uC2E4\uD5D8\uCCB4 DE5i1\uC740 \uB3C4\uB300\uCCB4
      \uBB50\uC57C?\n\n\uC5F0\uAD6C\uC6D02: \uB098\uB3C4 \uC120\uBC30\uD55C\uD14C
      \uC0B4\uC9DD \uBB3C\uC5B4\uBD24\uB294\uB370 \uC120\uBC30\uB9D0\uB85C\uB294
      \uC815\uCCB4\uB97C \uC544\uB294 \uC0AC\uB78C\uC740 \uC5C6\uB294 \uAC83 \uAC19\uB2E4\uB294\uB370?
      \uCD1D\uCC45\uC784\uC790\uB97C \uD3EC\uD568\uD574\uC11C \uB9D0\uC774\uC57C.
      \uAC89\uBAA8\uC2B5\uB9CC \uBD24\uC744\uB54C\uB294 \uC545\uB9C8\uAC19\uC740\uB370
      \uB9D0\uC774\uC57C.\n\n\uC5F0\uAD6C\uC6D01: \uADF8\uB7EC\uAC8C. \uB0B4\uAC00
      \uC5EC\uAE30\uC640\uC11C \uCC98\uC74C\uC73C\uB85C \uC545\uB9C8\uB098 \uADC0\uC2E0\uC744
      \uBBFF\uAC8C\uB410\uC796\uB0D0. \uC9C4\uC9DC \uC545\uB9C8\uC778\uAC00?\n\n\uC5F0\uAD6C\uC6D02:
      \uC5B4\uCA4C\uBA74 \uC815\uCCB4\uB97C \uC54C\uC544\uB0B4\uB294 \uAC83\uC774
      \uC5F0\uAD6C \uBAA9\uC801\uC77C\uC218\uB3C4 \uC788\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403152
    m_Localized: "\uB098\uB294 \uC774\uC81C \uC804\uB825\uC744 \uBCF5\uAD6C\uD55C
      \uB4A4 \uC0DD\uC874\uC790\uB97C \uCC3E\uC744 \uAC83\uC774\uB2E4.\n\uC0DD\uD65C\uB3D9
      \uC9C0\uD558\uC2E4\uC5D0\uC11C \uBB34\uC804\uC774 \uC640\uC11C \uADF8\uACF3\uC744
      \uBA3C\uC800 \uC218\uC0C9\uD55C \uD6C4 \uAE30\uC219\uC0AC\uB85C \uC774\uB3D9\uD560
      \uC608\uC815\uC774\uB2E4.\n\uC2E4\uD5D8\uC2E4 \uCD9C\uC785\uAD6C\uC758 \uBE44\uBC00\uBC88\uD638\uB97C
      \uBC14\uAFE8\uB2E4. \uBC14\uAFBC \uBC88\uD638\uB294 \uC218\uC0C9\uD558\uBA74\uC11C
      \uB0A8\uAE38 \uD14C\uB2C8 \uB4A4\uB97C \uBD80\uD0C1\uD55C\uB2E4.\n\n\uCD94\uC2E0:
      \uC2E4\uD5D8\uCCB4\uC758 \uC9C0\uB2A5\uC774 \uC0C1\uB2F9\uD788 \uB192\uC544
      \uBCF4\uC5EC \uC774\uB7F0 \uC870\uCE58\uB97C \uCDE8\uD588\uB2E4. \uC758\uBBF8\uAC00
      \uC788\uC744\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC, \uADF9\uB3C4\uB85C
      \uC8FC\uC758\uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 17085403153
    m_Localized: "\uCD08\uAE30 \uC2E4\uD5D8 \uB0B4\uC6A9 \uC815\uB9AC\uBCF8\uC785\uB2C8\uB2E4.
      \uD655\uC778 \uD6C4 \uAC80\uD1A0 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
