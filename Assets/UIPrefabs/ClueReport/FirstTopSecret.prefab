  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uADF9\uBE44 \uC2E4\uD5D8 \uBCF4\uACE0\uC11C\r\n\uC2E4\uD5D8\uCCB4: DE5i1\r\n\uBA58\uD15C
    \uB808\uAC8C\uB808 \uC2E4\uD5D8 - 13\uBC88\uC9F8 XX \uC790\uADF9 \uBC18\uC751
    \uC2E4\uD5D8 \uC774\uD6C4 \uCD94\uAC00 \uC2E4\uD5D8\r\n\r\nXX \uC790\uADF9\uC744
    \uAC00\uD55C \uD6C4 \uD1A0\uB07C\uB97C \uD22C\uC785\uD558\uC600\uB2E4. \uBD89\uC740
    \uC2E4\uC5D0 \uC811\uCD09\uD55C \uD1A0\uB07C\uC5D0\uAC8C\uC11C \uC774\uC0C1 \uBC18\uC751\uC774
    \uAD00\uCC30\uB418\uC5C8\uB2E4.\r\n\uC774\uD6C4 \uD574\uB2F9 \uC790\uADF9\uC744
    \uAC00\uD55C \uC5F0\uAD6C\uC6D0\uC774 \uBA85\uB839\uC744 \uB0B4\uB9AC\uC790 \uD1A0\uB07C\uAC00
    \uC774\uC5D0 \uB530\uB974\uB294 \uBAA8\uC2B5\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.
    \uB2E4\uB978 \uC5F0\uAD6C\uC6D0\uB4E4\uC758 \uBA85\uB839\uC5D0\uB294 \uBC18\uC751\uD558\uC9C0
    \uC54A\uC558\uB2E4.\r\n\r\n\uB450 \uBC88\uC9F8 \uC2E4\uD5D8\uC5D0\uC11C\uB294
    \uC0AC\uD615\uC218\uB97C \uD22C\uC785\uD55C \uD6C4 XX \uC790\uADF9\uC744 \uAC00\uD558\uC600\uB2E4.
    \uB3D9\uC77C\uD558\uAC8C \uC790\uADF9\uC744 \uAC00\uD55C \uC5F0\uAD6C\uC6D0\uC758
    \uBA85\uB839\uC5D0\uB9CC \uBC18\uC751\uD558\uB294 \uD604\uC0C1\uC774 \uAD00\uCC30\uB418\uC5C8\uB2E4.\r\n\uC774\uC0C1\uC758
    \uACB0\uACFC\uB97C \uD1B5\uD574 XX \uC790\uADF9\uC5D0 \uC758\uD574 \uD53C\uD5D8\uCCB4\uC758
    \uD589\uB3D9\uC744 \uC9C1\uC811\uC801\uC73C\uB85C \uD1B5\uC81C\uD560 \uC218 \uC788\uB294
    \uAC83\uC73C\uB85C \uD310\uB2E8\uB41C\uB2E4.\r\n\r\nXX \uC790\uADF9\uC744 \uD1B5\uD574
    \uD53C\uD5D8\uCCB4\uC758 \uC815\uC2E0 \uBC0F \uD589\uB3D9\uC744 \uD1B5\uC81C\uD558\uB294
    \uACFC\uC815\uC744 Mentem Regere, \uC57D\uCE59 Mentem\uC73C\uB85C \uBA85\uBA85\uD55C\uB2E4.\r\nMentem\uC5D0
    \uC758\uD574 \uD1B5\uC81C\uB418\uB294 \uD53C\uD5D8\uCCB4\uB294 Servus\uB85C \uBA85\uBA85\uD55C\uB2E4."
