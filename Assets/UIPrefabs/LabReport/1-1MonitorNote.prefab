  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC2E4\uD5D8 \uC77C\uC9C0\r\n\uC2E4\uD5D8\uCCB4: DE5i1\r\nX-ray, CT, MRI,
    \uCE74\uBA54\uB77C \uB4F1 \uBAA8\uB4E0 \uC601\uC0C1 \uC7A5\uBE44\uB97C \uC0AC\uC6A9\uD558\uC5EC
    \uAD00\uCC30\uC744 \uC2DC\uB3C4\uD588\uC73C\uB098, \uD655\uC778 \uAC00\uB2A5\uD55C
    \uB0B4\uBD80 \uAD6C\uC870\uB294 \uC874\uC7AC\uD558\uC9C0 \uC54A\uC558\uB2E4.\r\n\uADF8\uB7EC\uB098
    \uC678\uBD80 \uC790\uADF9\uC5D0 \uBC18\uC751\uD558\uB294 \uB4F1 \uC0DD\uBB3C\uACFC
    \uC720\uC0AC\uD55C \uBC18\uC751\uC744 \uBCF4\uC774\uB294 \uAC83\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\r\n\uD2B9\uD788
    \uBE5B\uACFC \uC18C\uB9AC\uC5D0 \uBBFC\uAC10\uD558\uAC8C \uBC18\uC751\uD558\uB294
    \uD2B9\uC131\uC774 \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\n\uC2E4\uD5D8 \uC77C\uC9C0\r\n\uC2E4\uD5D8\uCCB4:
    DE5i1\r\n\uC950, \uD1A0\uB07C, \uACF0\uC744 \uC21C\uCC28\uC801\uC73C\uB85C \uC2E4\uD5D8\uC2E4\uC5D0
    \uD22C\uC785\uD558\uC600\uB2E4.\r\n\uD22C\uC785\uC77C\uC740 6\uC6D4 X\uC77C,
    7\uC6D4 X\uC77C, 8\uC6D4 X\uC77C\uC774\uB2E4.\r\n\uBAA8\uB4E0 \uD53C\uD5D8 \uB3D9\uBB3C\uC5D0\uAC8C\uC11C
    \uC2E4\uD5D8\uCCB4\uB97C \uBC1C\uACAC\uD55C \uC9C1\uD6C4 \uADF9\uB3C4\uC758 \uACF5\uD3EC
    \uBC18\uC751\uC774 \uAD00\uCC30\uB418\uC5C8\uB2E4.\r\nDE5i1\uC740 \uD53C\uD5D8
    \uB3D9\uBB3C\uB4E4\uC744 \uC77C\uC815 \uC2DC\uAC04 \uAD00\uCC30\uD55C \uD6C4
    \uACF5\uACA9 \uD589\uB3D9\uC744 \uBCF4\uC600\uB2E4.\r\n\uACF5\uACA9 \uC774\uD6C4
    \uB3D9\uBB3C\uC758 \uC2E0\uCCB4\uB294 \uD615\uCCB4\uB97C \uC2DD\uBCC4\uD560 \uC218
    \uC5C6\uC744 \uC815\uB3C4\uB85C \uC2EC\uD558\uAC8C \uD6FC\uC190\uB418\uC5C8\uC73C\uBA70,
    \uC5BC\uB9C8 \uC9C0\uB098\uC9C0 \uC54A\uC544 \uAC80\uC740\uC0C9 \uB369\uC5B4\uB9AC
    \uD615\uD0DC\uB85C \uBCC0\uC774\uD558\uC600\uB2E4.\r\n\uD574\uB2F9 \uAC80\uC740\uC0C9
    \uBB3C\uC9C8\uC740 Fomes \uBA85\uBA85\uD55C\uB2E4."
