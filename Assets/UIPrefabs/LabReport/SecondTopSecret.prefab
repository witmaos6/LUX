  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uADF9\uBE44 \uC2E4\uD5D8 \uBCF4\uACE0\uC11C\r\n\uC2E4\uD5D8\uCCB4: Servus\r\nServus\uB294
    \uBA58\uD15C\uC744 \uAC00\uD55C \uC5F0\uAD6C\uC6D0\uC758 \uBA85\uB839\uC5D0\uB9CC
    \uBC18\uC751\uD558\uB294 \uD2B9\uC131\uC744 \uBCF4\uC774\uACE0 \uC788\uB2E4.\r\nServus\uC5D0\uAC8C
    '\uB0A0\uC544' \uB77C\uB294 \uBA85\uB839\uC744 \uB0B4\uB838\uB2E4. Servus\uB294
    \uB192\uC740 \uACF3\uC73C\uB85C \uC774\uB3D9\uD55C \uD6C4 \uB6F0\uC5B4\uB0B4\uB838\uB2E4.\r\n\uC2E4\uD589\uC774
    \uBD88\uAC00\uB2A5\uD55C \uBA85\uB839\uC5D0\uB3C4 \uC774\uD589\uD558\uB824\uB294
    \uBAA8\uC2B5\uC744 \uBCF4\uC778\uB2E4.\r\n\uC774\uD6C4 Servus\uC5D0\uAC8C XX\uC774\uB780
    \uBA85\uB839\uC744 \uB0B4\uB838\uB2E4.\r\n\uBA85\uB839 \uC9C1\uD6C4 Servus\uB97C
    \uC911\uC2EC\uC73C\uB85C \uBC18\uACBD \uC57D 20m \uBC94\uC704\uC5D0\uC11C \uACF5\uAC04\uC774
    \uC77C\uADF8\uB7EC\uC9C0\uB294 \uD604\uC0C1\uC774 \uBC1C\uC0DD\uD558\uC600\uB2E4.
    \uC7A0\uC2DC \uD6C4 \uD574\uB2F9 \uBC94\uC704 \uB0B4\uC758 \uD658\uACBD\uC774
    \uD30C\uAD34\uB41C \uAC83\uC73C\uB85C \uAD00\uCC30\uB418\uC5C8\uB2E4.\r\n\uC678\uD615\uC0C1
    \uD3ED\uBC1C\uC5D0 \uC758\uD55C \uD30C\uAD34\uC640 \uC720\uC0AC\uD558\uB098,
    \uC815\uD655\uD55C \uBC1C\uC0DD \uACFC\uC815\uC740 \uD655\uC778\uD558\uC9C0 \uBABB\uD588\uB2E4.
    \uD574\uB2F9 \uD604\uC0C1\uC740 \uCE74\uBA54\uB77C\uC5D0\uB3C4 \uC815\uC0C1\uC801\uC73C\uB85C
    \uAE30\uB85D\uB418\uC9C0 \uC54A\uC558\uB2E4.\r\n\r\nMentem \uBC0F Servus\uC640
    \uAD00\uB828\uB41C \uC2E4\uD5D8\uC740 \uADF9\uBE44 \uC0AC\uD56D\uC73C\uB85C \uBD84\uB958\uD55C\uB2E4.
    \uC77C\uBD80 \uC6A9\uC5B4 \uBC0F \uBA85\uB839\uC740 1\uAE09 \uAE30\uBC00\uB85C
    \uC9C0\uC815\uD558\uC5EC \uC5F4\uB78C\uC744 \uC81C\uD55C\uD55C\uB2E4."
